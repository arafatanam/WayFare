{
  "name": "@wayfare/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --ip 0.0.0.0",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply wayfare-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply wayfare-db --remote",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "@wayfare/shared": "^0.1.0",
    "better-auth": "^1.7.14",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14",
    "stripe": "^23.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261029.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "wrangler": "^4.155.0"
  }
}
